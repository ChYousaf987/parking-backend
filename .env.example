# PORT=2003
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
# JWT_SECRET=replace-with-a-long-random-secret
# QR_SIGNING_SECRET=replace-with-a-different-long-random-secret
# EMAIL_USER=your-email@example.com
# EMAIL_PASS=your-email-app-password
# STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Must match the publishable key used in the Flutter app (pk_test_...).
# Without this, PaymentSheet never opens because clientSecret is not created.
# ACCESS_TOKEN_EXPIRY=30d
# PORT=2003
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

